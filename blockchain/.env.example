# Copy to blockchain/.env (git-ignored). NEVER commit real values.
# Use a throw-away TESTNET wallet only - never a wallet that holds real funds.

# JSON-RPC endpoint for the Sepolia testnet (Alchemy / Infura / public node)
SEPOLIA_RPC_URL=
# Private key of a funded Sepolia TESTNET account (0x-prefixed)
DEPLOYER_PRIVATE_KEY=
# Optional: Etherscan API key for contract verification
ETHERSCAN_API_KEY=
